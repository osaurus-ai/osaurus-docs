{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "/api/mcp"
    }
  ],
  "headers": [
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.mjs": {
      "includeFiles": "generated/**",
      "maxDuration": 5
    }
  }
}
